# ══════════════════════════════════════════════════════════════════
# RestaurantOps AI — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
APP_NAME="RestaurantOps AI"
APP_VERSION="0.1.0"
DEBUG=false

# ── API ────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── CORS (comma-separated allowed origins) ─────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ───────────────────────────────────────────────────────
# Default: local SQLite file (no setup required for development)
DATABASE_URL=sqlite+aiosqlite:///./restaurantops.db

# ── Google Gemini AI ───────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── Telegram Bot ───────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get the token.
# Get your chat ID by messaging @userinfobot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Restaurant Location (used for Open-Meteo weather data) ─────────
RESTAURANT_LATITUDE=40.7128
RESTAURANT_LONGITUDE=-74.0060

# ── Scheduler (cron expressions) ───────────────────────────────────
INVENTORY_CHECK_CRON=0 8 * * *
DAILY_REPORT_CRON=0 9 * * *
